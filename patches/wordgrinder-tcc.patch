 #endif
 
+/* netbsd-curses implements the window accessors as real functions which
+ * dereference the window without a NULL check, while ncurses uses macros
+ * returning ERR. WordGrinder calls into the display before dpy_start()
+ * (notably in --lua script mode), so we have to guard the calls ourselves. */
+static bool started = false;
+
 void dpy_init(const char* argv[])
 {
 }
@@ -23,6 +29,7 @@
 void dpy_start(void)
 {
 	initscr();
+	started = true;
 	raw();
 	noecho();
 	meta(NULL, TRUE);
@@ -41,26 +48,40 @@
 
 void dpy_shutdown(void)
 {
+	if (!started)
+		return;
 	endwin();
+	started = false;
 }
 
 void dpy_clearscreen(void)
 {
+	if (!started)
+		return;
 	erase();
 }
 
 void dpy_getscreensize(int* x, int* y)
 {
+	if (!started)
+	{
+		*x = *y = -1;
+		return;
+	}
 	getmaxyx(stdscr, *y, *x);
 }
 
 void dpy_sync(void)
 {
+	if (!started)
+		return;
 	refresh();
 }
 
 void dpy_setcursor(int x, int y, bool shown)
 {
+	if (!started)
+		return;
 	move(y, x);
 }
 
