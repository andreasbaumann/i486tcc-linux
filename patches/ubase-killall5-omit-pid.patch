+static int
+omitted(pid_t pid)
 {
 	struct pidentry *pe;
+
+	if (pid == 1 || pid == getpid() ||
+	    getsid(pid) == getsid(0) || getsid(pid) == 0)
+		return 1;
+	SLIST_FOREACH(pe, &omitpid_head, entry)
+		if (pe->pid == pid)
+			return 1;
+	return 0;
+}
+
+/* Signal every non-omitted process. Used both for the requested signal
+ * and for the SIGSTOP/SIGCONT bracket below -- a process omitted via -o
+ * (e.g. nbd-client, blocked in a driver ioctl servicing a network block
+ * device) must not receive SIGSTOP either: delivery of any signal there
+ * makes its blocking wait return early, which the nbd driver treats as a
+ * dead connection and tears the socket down.
+ */
+static void
+signalall(int sig)
+{
 	struct dirent *entry;
 	DIR *dp;
+	pid_t pid;
+
+	if (!(dp = opendir("/proc")))
+		eprintf("opendir /proc:");
+	while ((entry = readdir(dp))) {
+		if (pidfile(entry->d_name) == 0)
+			continue;
+		pid = estrtol(entry->d_name, 10);
+		if (omitted(pid))
+			continue;
+		kill(pid, sig);
+	}
+	closedir(dp);
+}
