+/*
+ * Select which of the 4 VGA bitplanes subsequent writes to the aperture
+ * go to, via the Sequencer's Map Mask register (index 2 at 0x3c4/0x3c5).
+ * All 4 planes live at the same address range (e.g. 0xa0000), so this is
+ * the only thing that distinguishes writes to one plane from another.
+ */
+static void
+fbdevSetPlane (int plane)
+{
+    outb (0x02, 0x3c4);
+    outb (1 << plane, 0x3c5);
+}
+
+/*
+ * Window callback for shadowUpdatePlanar4/shadowUpdatePlanar4x8
+ * (miext/shadow/shplanar{,8}.c): they encode the target plane in the
+ * low 4 bits of "offset". The remaining bits are NOT a byte offset: both
+ * routines do their pointer arithmetic ("winBase + (scr - scrBase)") in
+ * units of the CARD32 words they write (each word holds 32 pixels' worth
+ * of 1bpp data for one plane), so "offset >> 4" must be multiplied by 4 to
+ * get the real byte offset. Getting this wrong doesn't show up at all for
+ * the first 32-pixel-wide word of a scanline (offset>>4 == 0 either way),
+ * only once damage starts at x >= 32 - which is what made it look fine in
+ * quick testing but corrupt real text.
+ */
+void *
+fbdevWindowPlanar (ScreenPtr	pScreen,
+		    CARD32	row,
+		    CARD32	offset,
+		    int		mode,
+		    CARD32	*size,
+		    void	*closure)
+{
+    KdScreenPriv(pScreen);
+    FbdevPriv	    *priv = pScreenPriv->card->driver;
+    int		    plane = offset & 0xf;
+    CARD32	    byteOffset = (offset >> 4) << 2;
+
+    if (!pScreenPriv->enabled)
+	return 0;
+    fbdevSetPlane (plane);
+    *size = priv->fix.line_length - byteOffset;
+    return (CARD8 *) priv->fb + row * priv->fix.line_length + byteOffset;
+}
